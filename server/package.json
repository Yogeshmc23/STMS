{
  "name": "@stms/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/db/migrations',{recursive:true});for(const f of fs.readdirSync('src/db/migrations'))fs.copyFileSync('src/db/migrations/'+f,'dist/db/migrations/'+f)\"",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx --env-file-if-exists=../.env src/db/migrate-cli.ts",
    "seed": "tsx --env-file-if-exists=../.env src/db/seed.ts"
  },
  "dependencies": {
    "@stms/shared": "*",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "nodemailer": "^10.1.4",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
